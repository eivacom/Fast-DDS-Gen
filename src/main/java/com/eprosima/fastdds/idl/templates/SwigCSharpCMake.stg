group SwigCMake;

swig_cmake(solution) ::= <<
cmake_minimum_required(VERSION 3.20)
project(FastDDSIDLWrapper)


find_package(fastcdr REQUIRED)
find_package(fastdds 3 REQUIRED)

find_package(SWIG REQUIRED CONFIG)
include(UseSWIG)
set(CMAKE_SWIG_FLAGS "")

# SWIG: use standard target name.
if(POLICY CMP0078)
  cmake_policy(SET CMP0078 NEW)
endif()

# SWIG: use SWIG_MODULE_NAME property.
if(POLICY CMP0086)
  cmake_policy(SET CMP0086 NEW)
endif()

set(\${PROJECT_NAME}_FILE
    eprosima_fastdds_idl.i
)

set(\${PROJECT_NAME}_SRC_FILES
$solution.projects : { project | $subproject_generated_src_files(project)$}; separator="\n"$
)

set_property(SOURCE \${\${PROJECT_NAME}_FILE} PROPERTY CPLUSPLUS ON)
set_property(SOURCE \${\${PROJECT_NAME}_FILE} PROPERTY USE_SWIG_DEPENDENCIES TRUE)
set_property(SOURCE \${\${PROJECT_NAME}_FILE} PROPERTY USE_TARGET_INCLUDE_DIRECTORIES TRUE)

swig_add_library(\${PROJECT_NAME}
    TYPE SHARED
    LANGUAGE csharp
    SOURCES
    \${\${PROJECT_NAME}_FILE}
    \${\${PROJECT_NAME}_SRC_FILES}
    )

set_property(TARGET \${PROJECT_NAME} PROPERTY SWIG_COMPILE_OPTIONS -namespace IDL)

if(UNIX AND CMAKE_SIZEOF_VOID_P EQUAL 8)
    set_property(TARGET \${PROJECT_NAME} PROPERTY SWIG_COMPILE_DEFINITIONS SWIGWORDSIZE64)
endif()

if(MSVC OR MSVC_IDE)
    target_compile_options(\${PROJECT_NAME} PRIVATE /bigobj)
endif()

target_include_directories(\${PROJECT_NAME} PUBLIC
    \$<BUILD_INTERFACE:\${CMAKE_CURRENT_SOURCE_DIR}>
)
target_link_libraries(\${PROJECT_NAME}
    fastcdr
    fastdds::fastdds
    )

>>

subproject_generated_src_files(project) ::= <<
    $project.commonSrcFilesUnixStyle : { file | $file$}; separator="\n"$
>>
