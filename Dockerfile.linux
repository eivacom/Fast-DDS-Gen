FROM ubuntu:22.04
# We can't use this -> ubuntu-fastdds:v3.2.2 right now because 

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y \
    dotnet-sdk-8.0 \
    aspnetcore-runtime-8.0 \
    build-essential \
    wget \
    libpcre3-dev \
    libpcre2-dev \
    libssl-dev \
    automake \
    bison \
    libffi-dev \
    libtool \
    cmake \
    openjdk-11-jdk \
    git

RUN apt-get clean && rm -rf /var/lib/apt/lists/*
    
# Build and install SWIG 4.3.0 from source
RUN cd /tmp && \
    wget https://github.com/swig/swig/archive/refs/tags/v4.3.0.tar.gz && \
    tar -xzf v4.3.0.tar.gz && \
    cd swig-4.3.0 && \
    ./autogen.sh && \
    ./configure && \
    make -j$(nproc) && \
    make install && \
    cd / && rm -rf /tmp/swig-4.3.0 /tmp/v4.3.0.tar.gz

RUN mkdir -p /home/fastddsgen

WORKDIR /home/fastddsgen

COPY . /home/fastddsgen/

RUN mkdir -p /home/fastddsgen/outputFolder
RUN mkdir -p /home/fastddsgen/inputFolder

RUN ./gradlew assemble

RUN mkdir -p /usr/local/share/fastddsgen/java/ && \ 
    cp /home/fastddsgen/share/fastddsgen/java/fastddsgen.jar /usr/local/share/fastddsgen/java/fastddsgen.jar && \
    cp /home/fastddsgen/scripts/fastddsgen /usr/local/bin/fastddsgen



CMD ["/bin/bash"]