FROM ubuntu:24.04
# We can't use this -> ubuntu-fastdds:v3.2.2 right now because 

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y \
    dotnet-sdk-8.0 \
    aspnetcore-runtime-8.0 \
    build-essential \
    wget \
    libpcre3-dev \
    libpcre2-dev \
    libssl-dev \
    automake \
    bison \
    libffi-dev \
    libtool \
    cmake \
    openjdk-11-jdk \
    libasio-dev \
    libtinyxml2-dev \
    mingw-w64 \
    # openssl \
    libssl-dev \
    git

RUN apt-get clean && rm -rf /var/lib/apt/lists/*


COPY . /home/fastddsgen/

# For do C# wrapper, it depends on Fast CDR + Fast DDS
# RUN mkdir -p /home/Fast-DDS-dependencies

